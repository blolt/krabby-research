+    // Krabby patch: fail on a short read (NACK/timeout) instead of returning
+    // BMI2_OK with an untouched buffer, which upstream ships as valid data.
+    if(interfaceData->i2cPort->requestFrom(interfaceData->i2cAddress, numBytes) != numBytes)
+    {
+        return BMI2_E_COM_FAIL;
+    }
 
     // Store all requested bytes
     for(uint32_t i = 0; i < numBytes && interfaceData->i2cPort->available(); i++)
@@ -1334,7 +1343,20 @@ BMI2_INTF_RETURN_TYPE BMI270::writeRegistersSPI(uint8_t regAddress, const uint8_
 /// @param interfacePtr Pointer to interface data, see BMI270_InterfaceData
 void BMI270::usDelay(uint32_t period, void* interfacePtr)
 {
-    delayMicroseconds(period);
+    // Krabby patch: AVR's delayMicroseconds() is only valid to 16383 us and
+    // silently overflows above that. The driver waits up to 51 ms this way
+    // (incl. the ~20 ms config-load validation wait), so a bare call makes
+    // bmi270_init fail with BMI2_E_CONFIG_LOAD on the Mega. Split into
+    // millisecond + microsecond parts; correct on every platform.
+    if (period >= 1000)
+    {
+        delay(period / 1000);
+        delayMicroseconds(period % 1000);
+    }
+    else
+    {
+        delayMicroseconds(period);
+    }
 }
 
